{
    "version": 2,
    "builds": [
        {
            "src": "api/**/*.js",
            "use": "@vercel/node"
        },
        {
            "src": "public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/danfe/html-base64",
            "dest": "/api/danfe/html-base64.js"
        },
        {
            "src": "/teste",
            "dest": "/public/index.html"
        },
        {
            "src": "/",
            "dest": "/api/index.js"
        }
    ]
}