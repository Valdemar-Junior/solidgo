# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Webhook Configuration
VITE_WEBHOOK_URL=https://your-n8n-instance.com/webhook/orders-import
VITE_WEBHOOK_SECRET=your_webhook_secret_here

# Application Configuration
VITE_APP_NAME=Delivery Route Manager
VITE_APP_VERSION=1.0.0

# Server-side (API) Configuration — do NOT expose in client
# These vars are required para o endpoint /api/reset-password funcionar
SUPABASE_URL=https://your_supabase_project_url
SUPABASE_SERVICE_KEY=your_service_role_key
SETUP_TOKEN=your_setup_token
NOMINATIM_USER_AGENT="SOLIDGO/1.0 (contact: troque-por-seu-email@dominio.com)"

# ===== Geracao de DANFE (server-side) =====
# Chave do cliente na API DanfeHub (aba Clientes). NUNCA use prefixo VITE_:
# tudo que e VITE_ vai para o navegador e viraria publico.
DANFE_API_KEY=cole_aqui_a_chave_do_danfehub
# URL base da API (opcional; o padrao ja e o de producao)
DANFE_API_URL=https://danfehub.lojaodosmoveis.shop

# Delivery proof feature flags (server-side)
DELIVERY_PROOF_ENABLED=false
DELIVERY_PROOF_REQUIRE_RECIPIENT=false
DELIVERY_PROOF_REQUIRE_GPS=false
DELIVERY_PROOF_BLOCK_ON_ERROR=false
